{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DragonMine Z Perfect Recall",
  "version": "0.3.3",
  "identifier": "dev.natanaeljose.dragonmine-perfect-recall",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DragonMine Z — Perfect Recall",
        "width": 1120,
        "height": 900,
        "minWidth": 880,
        "minHeight": 620,
        "backgroundColor": "#10150f",
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["binaries/dragonmine-bot.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
